class Dalli::Ring::Entry
  # pkg:gem/dalli#lib/dalli/ring.rb:147
  def initialize(val, srv); end

  # pkg:gem/dalli#lib/dalli/ring.rb:145
  def server; end

  # pkg:gem/dalli#lib/dalli/ring.rb:145
  def value; end
end

