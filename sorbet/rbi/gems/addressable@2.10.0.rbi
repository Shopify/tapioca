  # @return [String] The authority component.
  #
  # pkg:gem/addressable#lib/addressable/uri.rb:1360
  def authority; end

  # Sets the authority component for this URI.
  #
  # @param [String, #to_str] new_authority The new authority component.
  #
  # pkg:gem/addressable#lib/addressable/uri.rb:1400
  def authority=(new_authority); end

  # The basename, if any, of the file in the path component.
  #
  # @return [String] The path's basename.
  #
  # pkg:gem/addressable#lib/addressable/uri.rb:1736
  def basename; end

  # The default port for this URI's scheme.
  # This method will always returns the default port for the URI's scheme
  # regardless of the presence of an explicit port in the URI.
  #
  # @return [Integer] The default port.
  #
  # pkg:gem/addressable#lib/addressable/uri.rb:1603
  def default_port; end

  # This method allows you to make several changes to a URI simultaneously,
  # which separately would cause validation errors, but in conjunction,
  # are valid.  The URI will be revalidated as soon as the entire block has
  # been executed.
  #
  # @param [Proc] block
  #   A set of operations to perform on a given URI.
  #
  # pkg:gem/addressable#lib/addressable/uri.rb:2578
  def defer_validation; end

  # Creates a URI suitable for display to users. If semantic attacks are
  # likely, the application should try to detect these and warn the user.
  # See <a href="http://www.ietf.org/rfc/rfc3986.txt">RFC 3986</a>,
  # section 7.6 for more information.
  #
  # @return [Addressable::URI] A URI suitable for display purposes.
  #
  # pkg:gem/addressable#lib/addressable/uri.rb:2376
  def display_uri; end

  # Returns the public suffix domain for this host.
  #
  # @example
  #   Addressable::URI.parse("http://www.example.co.uk").domain # => "example.co.uk"
  #
  # pkg:gem/addressable#lib/addressable/uri.rb:1351
  def domain; end

  # Clones the URI object.
  #
  # @return [Addressable::URI] The cloned URI.
  #
  # pkg:gem/addressable#lib/addressable/uri.rb:2449
  def dup; end

  # Determines if the URI is an empty string.
