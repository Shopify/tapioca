# A literal's token: a run of non-ASCII pct-encoded octets, one triplet, or
# one character.
#
# pkg:gem/addressable#lib/addressable/template.rb:71
Addressable::Template::LITERAL_TOKEN = T.let(T.unsafe(nil), Regexp)

# MRI 3.2 memoizes a match, so that it takes linear time, unless the
# regexp has a lookaround, an atomic group, a possessive quantifier or a
# backreference, but can't say so. Later versions and TruffleRuby can.
#
# pkg:gem/addressable#lib/addressable/template.rb:3351
Addressable::Template::MEMOIZES_WITHOUT_LOOKAROUNDS = T.let(T.unsafe(nil), FalseClass)

# Looks up variables in a mapping that isn't enumerable, such as a lambda,
# once each. As with Hash#fetch, a KeyError means the variable is missing,
# and nil means it's defined as nil.
#
# pkg:gem/addressable#lib/addressable/template.rb:110
class Addressable::Template::MappingLookup
  # pkg:gem/addressable#lib/addressable/template.rb:113
  def initialize(source); end

  # pkg:gem/addressable#lib/addressable/template.rb:118
  def [](name); end

  # pkg:gem/addressable#lib/addressable/template.rb:123
  def key?(name); end

  private

  # pkg:gem/addressable#lib/addressable/template.rb:129
  def lookup(name); end

  # KeyError#key is Ruby 2.6+. For an error with no key, MRI raises and
  # TruffleRuby gives nil.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:147
  def missing?(error, name); end
end

# pkg:gem/addressable#lib/addressable/template.rb:111
Addressable::Template::MappingLookup::MISSING = T.let(T.unsafe(nil), Object)

# This class represents the data that is extracted when a Template
# is matched against a URI.
#
# pkg:gem/addressable#lib/addressable/template.rb:205
class Addressable::Template::MatchData
  # Creates a new MatchData object.
  # MatchData objects should never be instantiated directly.
  #
  # @param [Addressable::URI] uri
  #   The URI that the template was matched against.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:212
  def initialize(uri, template, mapping); end

  # Accesses captured values by name or by index.
  #
  # @param [String, Symbol, Fixnum] key
  #   Capture index or name. Note that when accessing by with index
  #   of 0, the full URI will be returned. The intention is to mimic
  #   the ::MatchData#[] behavior.
  #
  # @param [#to_int, nil] len
  #   If provided, an array of values will be returned with the given
  #   parameter used as length.
  #
  # @return [Array, String, nil]
  #   The captured value corresponding to the index or name. If the
  #   value was not provided or the key is unknown, nil will be
  #   returned.
  #
  #   If the second parameter is provided, an array of that length will
  #   be returned instead.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:279
  def [](key, len = T.unsafe(nil)); end

  # pkg:gem/addressable#lib/addressable/template.rb:258
  def captures; end

  # Returns a <tt>String</tt> representation of the MatchData's state.
  #
  # @return [String] The MatchData's state, as a <tt>String</tt>.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:322
  def inspect; end

  # pkg:gem/addressable#lib/addressable/template.rb:244
  def keys; end

  # @return [Hash]
  #   The mapping that resulted from the match.
  #   Note that this mapping does not include keys or values for
  #   variables that appear in the Template, but are not present
  #   in the URI.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:234
  def mapping; end

  # pkg:gem/addressable#lib/addressable/template.rb:245
  def names; end

  # pkg:gem/addressable#lib/addressable/template.rb:334
  def post_match; end

  # Dummy method for code expecting a ::MatchData instance
  #
  # @return [String] An empty string.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:331
  def pre_match; end

  # pkg:gem/addressable#lib/addressable/template.rb:303
  def string; end

  # @return [Addressable::Template]
  #   The Template used for the match.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:226
  def template; end

  # @return [Array]
  #   Array with the matched URI as first element followed by the captured
  #   values.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:293
  def to_a; end

  # @return [String]
  #   The matched URI as String.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:300
  def to_s; end

  # @return [Addressable::URI]
  #   The URI that the Template was matched against.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:221
  def uri; end

  # @return [Array]
  #   The list of values that were captured by the Template.
  #   Note that this list will include nils for any variables which
  #   were in the Template, but did not appear in the URI.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:252
  def values; end

  # Returns multiple captured values at once.
  #
  # @param [String, Symbol, Fixnum] *indexes
  #   Indices of the captures to be returned
  #
  # @return [Array]
  #   Values corresponding to given indices.
  #
  # @see Addressable::Template::MatchData#[]
  #
  # pkg:gem/addressable#lib/addressable/template.rb:314
  def values_at(*indexes); end

  # @return [Array]
  #   The list of variables that were present in the Template.
  #   Note that this list will include variables which do not appear
  #   in the mapping because they were not present in URI.
  #
  # pkg:gem/addressable#lib/addressable/template.rb:241
  def variables; end
end

# The operators that write each variable's name before its value.
