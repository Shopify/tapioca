# pkg:gem/addressable#lib/addressable/template.rb:3354
Addressable::Template::LINEAR_TIME_CHECKED = T.let(T.unsafe(nil), TrueClass)

# Expansion encodes non-ASCII literals (RFC 6570 section 3.1). An ASCII
# character the literals grammar leaves out stays as it is, as most other
# implementations do.
#
# pkg:gem/addressable#lib/addressable/template.rb:96
