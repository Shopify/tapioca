# pkg:gem/addressable#lib/addressable/template.rb:169
Addressable::Template::JOINERS = T.let(T.unsafe(nil), Hash)

# Characters that label expansion encodes, so a value can't contain them
# as they are: the reserved set (RFC 3986 section 2.2).
#
# pkg:gem/addressable#lib/addressable/template.rb:99
Addressable::Template::LABEL_DELIMITER = T.let(T.unsafe(nil), Regexp)

# pkg:gem/addressable#lib/addressable/template.rb:161
