  #   uri = Addressable::URI.parse("http://example.com/path?query")
  #   #=> #<Addressable::URI:0xcc5e7a URI:http://example.com/path?query>
  #   uri.omit(:scheme, :authority)
  #   #=> #<Addressable::URI:0xcc4d86 URI:/path?query>
